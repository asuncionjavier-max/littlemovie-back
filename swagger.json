{
  "openapi": "3.0.0",
  "info": {
    "title": "E-commerce API",
    "version": "1.0.0",
    "description": "API RESTful para E-commerce de películas desarrollada con Node.js, Express, Prisma y Supabase."
  },
  "servers": [
    {
      "url": "https://littlemovie-back.onrender.com/",
      "description": "servidor en la nube"
    },
    {
      "url": "http://localhost:3000",
      "description": "servidor local"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string","format": "uuid"},
          "name": {"type": "string", "maxLength": 50},
          "email": {"type": "string","format": "email","maxLength": 150},
          "password": {"type": "string","maxLength": 255},
          "age": {
            "type": "integer", "nullable": true},
          "city": {
            "type": "string", "maxLength": 50, "nullable": true},
          "postal_code": { "type": "string", "nullable": true},
          "role": {
            "type": "string", "maxLength": 50, "default": "USER" },
          "created_at": {
            "type": "string", "format": "date-time"},
          "updated_at": {
            "type": "string", "format": "date-time"}
        },
        "required": [
          "id",
          "name",
          "email",
          "password",
          "role",
          "created_at",
          "updated_at"
        ]
      },
      "Movie": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer" },
          "title": { "type": "string","maxLength": 255 },
          "year": { "type": "integer", "nullable": true },
          "director": { "type": "string", "maxLength": 255, "nullable": true },
          "genre": { "type": "string", "maxLength": 255, "default": "not null" },
          "price": { "type": "number","format": "double" },
          "rating": { "type": "number", "format": "float", "nullable": true},
          "created_at": { "type": "string", "format": "date-time"},
          "updated_at": { "type": "string", "format": "date-time"}
        },
        "required": [
          "id",
          "title",
          "genre",
          "price",
          "created_at",
          "updated_at"
        ]
      },
      "CartMovie": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "cart_id": { "type": "string", "format": "uuid"},
          "movie_id": { "type": "integer"},
          "quantity": {
            "type": "integer", "default": 1},
          "movies": { "$ref": "#/components/schemas/Movie"}
        },
        "required": [
          "id",
          "cart_id",
          "movie_id",
          "quantity"
        ]
      },
      "Cart": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid"},
          "user_id": { "type": "string", "format": "uuid", "nullable": true},
          "created_at": { "type": "string", "format": "date-time", "nullable": true},
          "cart_movies": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CartMovie"}
          }
        },
        "required": [
          "id"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer" },
          "order_id": { "type": "string", "format": "uuid"},
          "movie_id": { "type": "integer","nullable": true },
          "quantity": { "type": "integer", "default": 1 },
          "price_at_purchease": { "type": "number", "format": "double"},
          "movies": { "$ref": "#/components/schemas/Movie"}
        }, 
        "required": [
          "id",
          "order_id",
          "quantity",
          "price_at_purchease"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "order_status": { "type": "string", "default": "completed"},
          "created_at": { "type": "string", "format": "date-time", "nullable": true},
          "order_item": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItem" }
          }
        },
        "required": [
          "id",
          "user_id",
          "order_status"
        ]
      }
    }
  },
  "paths": {
    "/api/health":{
      "get": {
        "summary": "Verifica que el server funciona",
        "description": "Endpoint para confirmar que el server esta encendido"
      }
    },
    "/api/movies": {
      "get": {
        "tags": ["movies"],
        "summary": "Lista de peliculas",
        "description":"Trae la lista con todas las pelicuas",
        "responses": {
          "200" :{
              "description" : " Devuelve toda la lista de peliculas",
              "content" : {
                "application/json" : {
                  "schema" : {
                    "type" : "object",
                    "properties" : {
                      "success": {"type": "boolean", "example": "true"},
                      "data": {"$ref":"#/components/schemas/Movie"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/movies/{id}": {
      "parameters": [{
        "name": "id",
          "in": "path",
          "required": true,
          "description": "ID numérico de la película",
          "schema": {
          "type": "integer"
      }
    }
  ],
  "get": {
    "tags": ["movies"],
    "summary": "Obtener película por ID",
    "description": "Trae la película correspondiente a su ID",
    "responses": {
      "200": {
        "description": "Película encontrada",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": true },
                "data": { "$ref": "#/components/schemas/Movie" }
              }
            }
          }
        }
      },
      "404": {
        "description": "No se encontró ninguna película con ese ID"
      }
    }
  },
  "patch": {
    "tags": ["movies"],
    "summary": "Actualizar película por ID",
    "description": "Actualiza parcialmente los datos de una película",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Movie"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Película actualizada correctamente",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": true },
                "data": { "$ref": "#/components/schemas/Movie" }
              }
            }
          }
        }
      },
      "400": {
        "description": "Datos de entrada inválidos"
      },
      "404": {
        "description": "Película no encontrada"
      }
    }
  },
  "delete": {
    "tags": ["movies"],
    "summary": "Eliminar película por ID",
    "description": "Borra la película correspondiente al ID enviado",
    "responses": {
      "200": {
        "description": "Película eliminada correctamente"
      },
      "404": {
        "description": "Película no encontrada"
          }
        }
      }
  },
"/api/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Registro de usuario",
        "description": "Crea una nueva cuenta de usuario. Requiere name, email y password. Los campos age, city y postal_code son opcionales.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "example": "Tomate"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 150,
                    "example": "tomate@tomate.com"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "tomate1234"
                  },
                  "age": {
                    "type": "integer",
                    "nullable": true,
                    "example": 69
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 50,
                    "nullable": true,
                    "example": "Valencia"
                  },
                  "postal_code": {
                    "type": "string",
                    "nullable": true,
                    "example": "46181"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario registrado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Faltan campos obligatorios requeridos por el middleware checker",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Falta email por rellenar"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor o error de base de datos"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Inicio de sesión",
        "description": "Autentica un usuario con email y contraseña. Retorna una cookie 'access_token' HTTPOnly con el JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "tomate@tomate.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "tomate1234"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso. Establece la cookie 'access_token'",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "access_token=eyJhbGciOiJIUzI1...; Path=/; HttpOnly"
                },
                "description": "Cookie de autenticación que contiene el JWT"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Credenciales inválidas o faltan datos requeridos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Email o contraseña incorrecto"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Cierre de sesión",
        "description": "Elimina la cookie 'access_token' del navegador para finalizar la sesión.",
        "responses": {
          "200": {
            "description": "Sesión cerrada correctamente",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "access_token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT"
                },
                "description": "Expira la cookie para eliminarla del cliente"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "string",
                      "example": "Sesión cerrada"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    }
  }
}