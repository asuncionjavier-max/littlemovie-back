generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cart {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?       @db.Uuid
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  users       users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cart_movies cart_movies[]
}

model cart_movies {
  id       Int    @id @default(autoincrement())
  cart_id  String @db.Uuid
  movie_id Int
  quantity Int    @default(1)
  cart     cart   @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movies   movies @relation(fields: [movie_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_movies_movies_id_fkey")

  @@unique([cart_id, movie_id], map: "cart_movies_cart_id_movies_id_key")
}

model movies {
  id          Int           @id @default(autoincrement())
  title       String        @unique @db.VarChar(255)
  year        Int?
  director    String?       @db.VarChar(255)
  genre       String        @default("not null") @db.VarChar(255)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  price       Decimal       @default(0.00) @db.Decimal(10, 2)
  rating      Decimal?      @db.Decimal(3, 1)
  cart_movies cart_movies[]
  order_item  order_item[]
}

model order_item {
  id                 Int     @id(map: "item_orders_pkey") @default(autoincrement())
  order_id           String  @db.Uuid
  movie_id           Int?
  quantity           Int     @default(1)
  price_at_purchease Decimal @db.Decimal(10, 2)
  movies             movies? @relation(fields: [movie_id], references: [id], onUpdate: NoAction, map: "item_orders_movie_id_fkey")
  orders             orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "item_orders_order_id_fkey")
}

model orders {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String       @db.Uuid
  order_status String       @default("completed") @db.VarChar(50)
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  order_item   order_item[]
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum Role {
  admin
  user
}

model users {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(50)
  email       String   @unique @db.VarChar(150)
  password    String   @db.VarChar(255)
  role        Role     @default(user)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  age         Int?
  city        String?  @db.VarChar(50)
  postal_code String?
  cart        cart[]
  orders      orders[]
}
